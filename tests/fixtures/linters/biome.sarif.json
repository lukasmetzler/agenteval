{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Biome",
          "informationUri": "https://biomejs.dev",
          "rules": [
            {
              "id": "lint/correctness/noUnusedVariables",
              "shortDescription": {
                "text": "Disallow unused variables."
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-unused-variables"
            },
            {
              "id": "lint/suspicious/noDebugger",
              "shortDescription": {
                "text": "Disallow the use of `debugger`"
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-debugger"
            },
            {
              "id": "lint/suspicious/noExplicitAny",
              "shortDescription": {
                "text": "Disallow the `any` type usage."
              },
              "helpUri": "https://biomejs.dev/linter/rules/no-explicit-any"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "lint/correctness/noUnusedVariables",
          "level": "warning",
          "message": {
            "text": "This variable x is unused."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.js"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 7,
                  "endLine": 3,
                  "endColumn": 8
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/suspicious/noExplicitAny",
          "level": "warning",
          "message": {
            "text": "Unexpected any. Specify a different type."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.ts"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 17,
                  "endLine": 2,
                  "endColumn": 20
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/correctness/noUnusedVariables",
          "level": "warning",
          "message": {
            "text": "This variable unused is unused."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.ts"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 7,
                  "endLine": 1,
                  "endColumn": 13
                }
              }
            }
          ]
        },
        {
          "ruleId": "lint/suspicious/noDebugger",
          "level": "error",
          "message": {
            "text": "This is an unexpected use of the debugger statement."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.js"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 3,
                  "endLine": 2,
                  "endColumn": 12
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
